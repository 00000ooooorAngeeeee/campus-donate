{
  "name": "campus-donate",
  "version": "0.1.0",
  "private": true,
  "description": "拾光 · 校园旧物捐赠平台（npm workspaces：front + backend）",
  "workspaces": [
    "project/front",
    "project/backend"
  ],
  "engines": {
    "node": ">=20.10",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w project/front",
    "start": "npm run start -w project/backend",
    "db:push": "npm run db:push -w project/backend",
    "db:seed": "npm run db:seed -w project/backend",
    "db:reset": "npm run db:reset -w project/backend"
  }
}
